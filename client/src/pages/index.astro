---
import './index.scss'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="shortcut icon" href="/rubiks-cube.png" type="image/x-icon">
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Rubiks Cube Blind Solver</title>
	</head>
	<body>
		<canvas class="gl"></canvas>
		<script>
			import main from "../Engine/main"

			const canvas = document.querySelector('canvas.gl') as HTMLCanvasElement

			main(canvas)
		</script>
	</body>
</html>
